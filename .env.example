# Hedera Notary Log - Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# HEDERA CONFIGURATION (Required)
# =============================================================================

# Network: 'testnet' or 'mainnet' (start with testnet)
HEDERA_NETWORK=testnet

# Your Hedera operator account ID (e.g., 0.0.123456)
# Get one free at: https://portal.hedera.com/
HEDERA_OPERATOR_ID=0.0.YOUR_ACCOUNT_ID

# Your Hedera operator private key (DER encoded hex string)
# NEVER commit this to version control!
HEDERA_OPERATOR_KEY=YOUR_PRIVATE_KEY_HERE

# HCS Topic ID for storing notarization records
# You'll create this topic after setting up your account
HEDERA_TOPIC_ID=0.0.YOUR_TOPIC_ID

# =============================================================================
# MIRROR NODE CONFIGURATION (Required)
# =============================================================================

# Mirror Node REST API base URL
# Testnet: https://testnet.mirrornode.hedera.com
# Mainnet: https://mainnet-public.mirrornode.hedera.com
MIRROR_NODE_BASE_URL=https://testnet.mirrornode.hedera.com

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Maximum message size in bytes (default: 4096)
# MAX_MESSAGE_BYTES=4096

# Rate limit per minute per IP (default: 60)
# RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# NEXT.JS CONFIGURATION
# =============================================================================

# Public network indicator used by the client UI (receipt links, explorer links, etc.)
# Keep this in sync with HEDERA_NETWORK.
NEXT_PUBLIC_HEDERA_NETWORK=testnet

# Public Mirror Node base URL used for explorer links in the UI.
# This is not sensitive.
NEXT_PUBLIC_MIRROR_NODE_BASE_URL=https://testnet.mirrornode.hedera.com

# Base URL for the application (used for generating verification links)
# Development: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

